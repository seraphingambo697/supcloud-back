# .env.example

# Base de données
DATABASE_URL=postgresql+asyncpg://supcloud_user:supcloud@db:5432/supcloud
DATABASE_URL_SYNC=postgresql://supcloud_user:supcloud@db:5432/supfile

# JWT
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# OAuth2 Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# OAuth2 — GitHub 
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=

# CORS 
ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://localhost:8080
